<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="#101C29"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="26">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Grip" Background="#48647B" CornerRadius="4" Margin="2"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#6F95AC"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#66D6DD"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#152332"/><Setter Property="Foreground" Value="#F4F8FC"/>
    <Setter Property="BorderBrush" Value="#48647B"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="8"/>
    <Setter Property="SelectionBrush" Value="#356F89"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="#20364C"/><Setter Property="Foreground" Value="#F4F8FC"/>
    <Setter Property="BorderBrush" Value="#48647B"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,4,0,4"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2D4C66"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DFE8F1"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#DFE8F1"/><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#AAC0D2"/></Style>
</ResourceDictionary>
